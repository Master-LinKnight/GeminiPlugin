{
  "manifestVersion": 5,
  "id": "com.gemini.nanobanana.plugin",
  "name": "Gemini AI Generator",
  "version": "1.0.0",
  "main": "index.html",
  "host": [
    {
      "app": "PS",
      "minVersion": "24.0.0"
    }
  ],
  "entrypoints": [
    {
      "type": "panel",
      "id": "geminiGeneratorPanel",
      "label": {
        "default": "Gemini AI 生图"
      },
      "minimumSize": {
        "width": 260,
        "height": 380
      },
      "preferredDockedSize": {
        "width": 300,
        "height": 550
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess"
  }
}
