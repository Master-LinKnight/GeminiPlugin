{
  "manifestVersion": 5,
  "id": "com.gemini.nanobanana.plugin",
  "name": "Gemini AI Generator",
  "version": "1.2.0",
  "main": "index.html",
  "host": {
    "app": "PS",
    "minVersion": "25.0.0",
    "data": {
      "apiVersion": 2
    }
  },
  "entrypoints": [
    {
      "type": "panel",
      "id": "geminiGeneratorPanel",
      "label": {
        "default": "Gemini AI 生图",
        "zh-CN": "Gemini AI 生图",
        "en-US": "Gemini AI Generator"
      },
      "minimumSize": {
        "width": 260,
        "height": 400
      },
      "preferredDockedSize": {
        "width": 320,
        "height": 620
      },
      "preferredFloatingSize": {
        "width": 320,
        "height": 620
      }
    }
  ],
  "requiredPermissions": {
    "network": {
      "domains": "all"
    },
    "localFileSystem": "fullAccess"
  }
}
